#!/usr/bin/env python3
"""igcli — Instagram CLI ala wacli.

Perintah berbasis subcommand untuk baca profil, kirim/baca DM, dan outreach
prospek, di atas connector Instagram yang sudah terhubung. Output default
tabel ringkas; --json untuk machine-readable.

Contoh:
  igcli accounts
  igcli profile --username mensflix.id
  igcli resolve mensflix.id
  igcli dm inbox --first 10
  igcli dm send --to mensflix.id --text "Halo kak..." --dry-run
  igcli dm outreach --dry-run
  igcli doctor
"""
import argparse, json, os, sqlite3, subprocess, sys
from datetime import datetime, timezone, timedelta

VERSION = "0.1.0"
WIB = timezone(timedelta(hours=7))
IG_CLI = "/opt/hatch/bin/instagram-cli"
IG_MSG = "/opt/hatch/bin/instagram-messages-cli"
STORE_DIR = os.path.expanduser("~/.local/state/igcli")
DB_PATH = os.path.join(STORE_DIR, "igcli.db")

# Akun default per perintah (fbid). @ahliwebmurah_id non-profesional:
# DM ke orang asing diblokir IG (403). @bikinweb.murah profesional: bisa.
DEFAULT_ACCOUNT = "17841447943236724"   # @ahliwebmurah_id
PRO_ACCOUNT = "17841460805634325"       # @bikinweb.murah (profesional)


def run_cli(args, timeout=90):
    p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    return p.returncode, p.stdout, p.stderr


def jload(s):
    try:
        return json.loads(s)
    except Exception:
        return {}


def my_accounts():
    """Daftar akun IG sendiri: username -> {fbid, igid}."""
    rc, out, _ = run_cli([IG_CLI, "accounts"])
    accs = {}
    if rc == 0:
        for a in jload(out).get("accounts", []):
            accs[a.get("username")] = {"fbid": a.get("user_fbid"), "igid": a.get("user_igid")}
    return accs


def msg_accounts():
    """Status koneksi messaging per fbid."""
    rc, out, _ = run_cli([IG_MSG, "accounts"])
    st = {}
    if rc == 0:
        for a in jload(out).get("accounts", []):
            st[a.get("user_fbid")] = {"connected": a.get("connected"),
                                     "professional": a.get("is_professional"),
                                     "username": a.get("username")}
    return st


def resolve_account(name_or_fbid):
    """Terima @username / username / fbid -> fbid. None kalau tidak ketemu."""
    if not name_or_fbid:
        return DEFAULT_ACCOUNT
    s = name_or_fbid.strip().lstrip("@")
    if s.isdigit():
        return s
    accs = my_accounts()
    hit = accs.get(s)
    return hit["fbid"] if hit else None


def username_of(fbid):
    for u, a in my_accounts().items():
        if a["fbid"] == fbid:
            return "@" + u
    return fbid


# ---------- store lokal (ala wacli) ----------
def store():
    os.makedirs(STORE_DIR, exist_ok=True)
    con = sqlite3.connect(DB_PATH)
    con.execute("""CREATE TABLE IF NOT EXISTS threads(
        thread_fbid TEXT PRIMARY KEY, account_fbid TEXT,
        participants TEXT, preview TEXT, updated_at TEXT)""")
    con.execute("""CREATE TABLE IF NOT EXISTS messages(
        message_id TEXT PRIMARY KEY, thread_fbid TEXT,
        sender TEXT, text TEXT, sent_at TEXT)""")
    return con



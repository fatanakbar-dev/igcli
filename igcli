def cmd_prospect_check(args):
    """Verifikasi calon prospek: profil + heuristik kecocokan."""
    acct = resolve_account(args.account)
    handle = args.handle.lstrip("@")
    rc, out, _ = run_cli([IG_CLI, "profile", "--account-id", acct, "--username", handle])
    profs = jload(out).get("profiles", [])
    if not profs:
        print(json.dumps({"handle": "@" + handle, "found": False}))
        sys.exit(1)
    p = profs[0]
    bio = str(p.get("bio") or "")
    biz = p.get("business_info") or {}
    followers = p.get("follower_count") or 0
    has_website = bool(p.get("website") or biz.get("website") or
                       "linktr.ee" in bio.lower() or ".com" in bio.lower() or
                       ".id" in bio.lower() or ".co.id" in bio.lower())
    has_contact = bool(biz.get("email") or biz.get("phone") or
                       "wa.me" in bio.lower() or "whatsapp" in bio.lower())
    checks = []
    if p.get("is_private"):
        checks.append(("skip", "akun private"))
    if followers < 50:
        checks.append(("kurang", f"followers kecil ({followers})"))
    elif followers > 100000:
        checks.append(("kurang", f"terlalu besar ({followers}) — kemungkinan sudah punya tim/agensi"))
    if has_website:
        checks.append(("catatan", "kemungkinan sudah punya website/link — cek manual"))
    if has_contact:
        checks.append(("plus", "ada kontak di bio (email/WA)"))
    if not checks:
        checks.append(("cocok", "lolos filter dasar"))
    result = {"handle": "@" + p.get("username"), "nama": p.get("name"),
              "followers": followers, "posts": p.get("post_count"),
              "private": p.get("is_private"), "bio": bio[:150],
              "website_terdeteksi": has_website, "kontak_terdeteksi": has_contact,
              "penilaian": [{"status": s, "alasan": r} for s, r in checks]}
    print(json.dumps(result, indent=1, ensure_ascii=False))


def publish_lock():
    """Lockfile sederhana: cegah 2 proses posting jalan barengan.
    Return True kalau lock didapat, False kalau ada posting lain berjalan."""
    lock = os.path.join(STORE_DIR, "post.lock")
    os.makedirs(STORE_DIR, exist_ok=True)
    if os.path.exists(lock):
        try:
            age = datetime.now().timestamp() - os.path.getmtime(lock)
            if age < 3600:  # lock kedaluwarsa 1 jam (antisipasi crash)
                return False
        except OSError:
            pass
    open(lock, "w").write(str(os.getpid()))
    return True


def publish_unlock():
    try:
        os.remove(os.path.join(STORE_DIR, "post.lock"))
    except OSError:
        pass


def cmd_sync(args):
    acct = resolve_account(args.account)
    rc, out, _ = run_cli([IG_MSG, "inbox", "--account-id", acct,
                          "--first", str(args.first), "--message-count", "3"])
    threads = jload(out).get("threads", [])
    con = store()
    n = 0
    for t in threads:
        names = ",".join("@" + u.get("username", "?") for u in t.get("users", []))
        con.execute("INSERT OR REPLACE INTO threads VALUES (?,?,?,?,?)",
                    (t.get("thread_fbid"), acct, names,
                     str(t.get("preview", ""))[:200],
                     datetime.now(WIB).isoformat()))
        n += 1
    con.commit()
    print(f"Sync {n} thread dari {username_of(acct)} ke {DB_PATH}")



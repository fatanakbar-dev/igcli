def main():
    ap = argparse.ArgumentParser(prog="igcli", description="Instagram CLI ala wacli")
    ap.add_argument("--account", help="@username atau fbid pengirim (default @ahliwebmurah_id)")
    ap.add_argument("--json", action="store_true", help="output JSON")
    ap.add_argument("--version", action="store_true")
    sub = ap.add_subparsers(dest="cmd")

    sub.add_parser("accounts", help="daftar akun + status messaging")
    p = sub.add_parser("auth", help="status autentikasi")
    p.add_argument("what", nargs="?", default="status")

    p = sub.add_parser("profile", help="lihat profil IG")
    p.add_argument("--username", required=True)

    p = sub.add_parser("resolve", help="handle -> fbid")
    p.add_argument("handle")

    p = sub.add_parser("dm", help="direct messages")
    dsub = p.add_subparsers(dest="dm_cmd")
    p2 = dsub.add_parser("inbox", help="daftar thread DM")
    p2.add_argument("--first", type=int, default=10)
    p2 = dsub.add_parser("thread", help="baca thread")
    p2.add_argument("--id", required=True)
    p2.add_argument("--first", type=int, default=20)
    p2 = dsub.add_parser("send", help="kirim DM")
    p2.add_argument("--to", required=True, help="@handle atau fbid")
    p2.add_argument("--text", required=True)
    p2.add_argument("--dry-run", action="store_true")
    p2 = dsub.add_parser("outreach", help="kirim 1 DM ke prospek berikutnya")
    p2.add_argument("--dry-run", action="store_true")
    p2.add_argument("--max-per-day", type=int, default=10)

    p = sub.add_parser("post", help="posting konten")
    psub = p.add_subparsers(dest="post_cmd")
    p2 = psub.add_parser("reel", help="posting reels (MP4 + cover)")
    p2.add_argument("--file", required=True)
    p2.add_argument("--cover", required=True)
    p2.add_argument("--caption", default="")
    p2.add_argument("--dry-run", action="store_true")
    p2 = psub.add_parser("photo", help="posting foto/carousel")
    p2.add_argument("--file", required=True, action="append")
    p2.add_argument("--caption", default="")
    p2.add_argument("--dry-run", action="store_true")
    p2 = psub.add_parser("story", help="posting story")
    p2.add_argument("--file", required=True)
    p2.add_argument("--editor-json", default="")
    p2.add_argument("--draft", action="store_true", help="render saja, tanpa publish")
    p2.add_argument("--dry-run", action="store_true")

    p = sub.add_parser("posts", help="daftar postingan akun")

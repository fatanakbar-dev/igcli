def cmd_dm_send(args):
    acct = resolve_account(args.account)
    to = args.to.strip()
    fbid = to if to.isdigit() else None
    handle = None
    if not fbid:
        handle = to.lstrip("@")
        rc, out, _ = run_cli([IG_CLI, "profile", "--account-id", acct, "--username", handle])
        profs = jload(out).get("profiles", [])
        if not profs or not profs[0].get("user_id"):
            print(f"Tidak bisa resolve @{handle}", file=sys.stderr)
            sys.exit(1)
        fbid = profs[0]["user_id"]
    dest = "@" + handle if handle else fbid
    if args.dry_run:
        print(json.dumps({"dry_run": True, "from": username_of(acct),
                          "to": dest, "fbid": fbid, "text": args.text}, indent=1,
                         ensure_ascii=False))
        return
    rc, out, err = run_cli([IG_MSG, "send", "--account-id", acct,
                            "--recipient-user-fbids", fbid, "--text", args.text],
                           timeout=120)
    if rc == 0 and "message_id" in out:
        print(json.dumps({"sent": True, "to": dest, "result": jload(out)},
                         ensure_ascii=False))
    else:
        print(f"GAGAL: {(out + err)[:400]}", file=sys.stderr)
        sys.exit(1)


def cmd_dm_outreach(args):
    """1 DM outreach ke prospek berikutnya. Dipakai cron tiap 45 mnt."""
    sys.path.insert(0, os.path.expanduser("~/workspace/prospek-hunting"))
    try:
        import ig_dm_outreach as o
    except ImportError:
        print("dm outreach butuh ~/workspace/prospek-hunting/ig_dm_outreach.py "
              "(tidak termasuk di repo ini).", file=sys.stderr)
        sys.exit(1)
    acct = args.account or PRO_ACCOUNT  # default akun profesional (bisa DM ke orang asing)
    if resolve_account(acct) is None:
        print("Akun tidak dikenal", file=sys.stderr)
        sys.exit(1)
    o.ACCOUNT_ID = resolve_account(acct)
    log = o.load_log()
    if o.sent_today(log) >= (args.max_per_day or o.DAILY_CAP):
        print(json.dumps({"skipped": "cap_harian_tercapai"}))
        return
    p = o.pick_prospect(log)
    if not p:
        print(json.dumps({"skipped": "tidak_ada_prospek"}))
        return
    handle = p["sumber"].split("instagram:", 1)[1].strip().lstrip("@")
    fbid = o.resolve_fbid(handle)
    now = o.now_wib()
    entry = {"prospek_id": p["id"], "nama": p["nama"], "handle": handle,
             "kategori": p["kategori"], "via": username_of(o.ACCOUNT_ID),
             "sent_at": now.strftime("%Y-%m-%dT%H:%M:%S%z")}
    if not fbid:
        entry.update(status="skip", error="resolve_gagal")
        log.append(entry); o.save_log(log)
        print(json.dumps(entry, ensure_ascii=False))
        return
    entry["fbid"] = fbid
    text = o.ig_dm_message(p["nama"], p["kategori"] or "")
    if args.dry_run:
        entry.update(status="dry_run", text=text)
        print(json.dumps(entry, indent=1, ensure_ascii=False))
        return
    ok, info = o.send_dm(fbid, text)
    entry.update(status="sent" if ok else "failed")
    if not ok:
        entry["error"] = info
    log.append(entry); o.save_log(log)
    print(json.dumps({"status": entry["status"], "to": "@" + handle,
                      "via": entry["via"]}, ensure_ascii=False))
    if not ok:
        sys.exit(1)


def cmd_post_reel(args):
    """Posting reels: MP4 + cover + caption (bungkus post-feed)."""
    acct = resolve_account(args.account)
    for f in [args.file, args.cover]:
        if not os.path.isfile(f) or "/tmp" in os.path.abspath(f):
            print(f"File harus ada di ~/workspace/, bukan /tmp: {f}", file=sys.stderr)
            sys.exit(1)
    cmd = [IG_CLI, "post-feed", "--account-id", acct,
           "--file", args.file, "--cover", args.cover]
    if args.caption:
        cmd += ["--caption", args.caption]
    if args.dry_run:
        print(json.dumps({"dry_run": True, "from": username_of(acct),
                          "file": args.file, "cover": args.cover,
                          "caption": args.caption}, ensure_ascii=False, indent=1))
        return
    if not publish_lock():
        print("Ada proses posting lain yang berjalan — batalkan untuk keamanan.",
              file=sys.stderr)
        sys.exit(1)
    try:
        rc, out, err = run_cli(cmd, timeout=600)
        print(out[:500] or err[:500])
        if rc != 0:
            sys.exit(1)
    finally:
        publish_unlock()



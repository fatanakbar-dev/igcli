def cmd_resolve(args):
    """Handle -> fbid (+ info ringkas). Dipakai outreach untuk --recipient-user-fbids."""
    acct = resolve_account(args.account)
    handle = args.handle.lstrip("@")
    rc, out, err = run_cli([IG_CLI, "profile", "--account-id", acct, "--username", handle])
    profs = jload(out).get("profiles", [])
    if not profs or not profs[0].get("user_id"):
        print(json.dumps({"handle": handle, "found": False}))
        sys.exit(1)
    p = profs[0]
    info = {"handle": "@" + p.get("username"), "fbid": p.get("user_id"),
            "name": p.get("name"), "followers": p.get("follower_count"),
            "private": p.get("is_private"), "found": True}
    print(json.dumps(info, indent=1))


